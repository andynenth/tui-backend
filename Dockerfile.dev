# Frontend build stage
FROM node:23-alpine as frontend-builder
WORKDIR /app

# Install build dependencies for native modules
RUN apk add --no-cache python3 make g++ libc6-compat

# Copy package files and install dependencies
COPY frontend/package*.json ./
RUN npm ci

# Copy frontend source and build
COPY frontend/ ./
RUN npm run build

# Python development stage
FROM python:3.11-slim
WORKDIR /app

# Create non-root user for security (same as prod)
RUN groupadd -r appuser && useradd -r -g appuser appuser

# Install system dependencies for health checks
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Copy application files
COPY backend/ ./backend
COPY shared/ ./shared

# Create data directory for database and logs directory with correct permissions
RUN mkdir -p /app/data /app/logs && chown -R appuser:appuser /app/data /app/logs

# Copy built frontend files from frontend-builder stage
COPY --from=frontend-builder /app/bundle.* ./backend/static/
COPY --from=frontend-builder /app/package.json ./frontend-package.json
COPY --from=frontend-builder /app/bundle.*.map ./backend/static/
COPY --from=frontend-builder /app/index.html ./backend/static/

# Copy VERSION file if it exists (created during build)
COPY VERSION* ./

# Copy favicon.ico to the root directory
COPY favicon.ico ./

# Set ownership but DON'T switch to non-root user for development (allows hot reload)
RUN chown -R appuser:appuser /app

# Health check using existing health endpoint
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD curl -f http://localhost:5050/api/health || exit 1

# Environment configuration
ENV PYTHONPATH=/app
ENV DEBUG=true
ENV API_HOST=0.0.0.0
ENV API_PORT=5050
ENV RUNNING_IN_DOCKER=true

EXPOSE 5050

# Development command with reload enabled
CMD ["uvicorn", "backend.api.main:app", "--host", "0.0.0.0", "--port", "5050", "--reload", "--workers", "1"]